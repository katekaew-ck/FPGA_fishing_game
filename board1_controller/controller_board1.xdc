set_property -dict { PACKAGE_PIN H11 IOSTANDARD LVCMOS33 } [get_ports {clk}]
create_clock -name sys_clk -period 20 [get_ports {clk}]
set_property -dict { PACKAGE_PIN J14 IOSTANDARD LVCMOS33 PULLDOWN true } [get_ports {reset_button}]
set_property -dict { PACKAGE_PIN H14 IOSTANDARD LVCMOS33 PULLUP true } [get_ports {btn_left_n}]
set_property -dict { PACKAGE_PIN H13 IOSTANDARD LVCMOS33 PULLUP true } [get_ports {btn_right_n}]
set_property -dict { PACKAGE_PIN L14 IOSTANDARD LVCMOS33 PULLUP true } [get_ports {enc_a}]
set_property -dict { PACKAGE_PIN M13 IOSTANDARD LVCMOS33 PULLUP true } [get_ports {enc_b}]
set_property -dict { PACKAGE_PIN G11 IOSTANDARD LVCMOS33 } [get_ports {uart_tx}]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
